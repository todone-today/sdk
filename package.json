{
  "name": "@todone/sdk",
  "version": "0.10.3",
  "description": "todone's shared logic: the task model and its Markdown format, calendar maths, export, sync planning, integrations, reminders (and sealed Web Push) and end-to-end encryption.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-today/sdk.git"
  }
}
